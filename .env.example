# Firebase web app config (public identifiers, not secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check: set ONE of the two site keys.
VITE_RECAPTCHA_ENTERPRISE_KEY=
VITE_RECAPTCHA_V3_KEY=

# Local development only: prints an App Check debug token in the console.
VITE_APPCHECK_DEBUG=false
